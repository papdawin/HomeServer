apiVersion: v1
kind: PersistentVolume
metadata:
  name: immich-library
spec:
  capacity: {storage: 2Ti}
  accessModes: [ReadWriteMany]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  mountOptions: [hard, nfsvers=4.1, noatime]
  nfs:
    server: ${truenas_address}
    path: /mnt/HDD/data/photos/immich
  claimRef:
    apiVersion: v1
    kind: PersistentVolumeClaim
    name: immich-library
    namespace: immich
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: immich-library
  namespace: immich
spec:
  accessModes: [ReadWriteMany]
  storageClassName: ""
  volumeName: immich-library
  resources:
    requests: {storage: 2Ti}
---
